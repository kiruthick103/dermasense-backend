# =============================================================================
# DERMASENSE MULTI-PORTAL CONFIGURATION
# =============================================================================

# Supabase Project Credentials
# Obtain these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Fallback & Demo Mode Settings
# When set to true, allows rapid evaluation and testing even before Supabase keys are configured
DEMO_FALLBACK_MODE=true

# Server Port
PORT=8008
HOST=0.0.0.0
